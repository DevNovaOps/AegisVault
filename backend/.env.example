# AegisVault Backend Environment Configuration
# Copy this file to .env and fill in your values

# Django Core
SECRET_KEY=change-me-to-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL)
DB_NAME=aegisvault
DB_USER=aegisvault_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (for notifications/invitations)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@aegisvault.io

# Encryption
VAULT_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

# Admin enrollment key (must match frontend expectations)
ADMIN_ENROLLMENT_KEY=ROOT-SEC-8821
ADMIN_CLEARANCE_TOKEN=AEGIS-ROOT-9092
